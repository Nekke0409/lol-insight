# Local-only values belong in .env, which is intentionally ignored by Git.
# bootRun loads this file automatically. Existing shell variables take precedence.
SPRING_PROFILES_ACTIVE=local

# PostgreSQL / Redis defaults for docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lol_insight
POSTGRES_USER=lol_insight
POSTGRES_PASSWORD=lol-insight-local

RIOT_API_KEY=
OPENAI_API_KEY=
REDIS_HOST=localhost
REDIS_PORT=6379
